# ==============================================================================
# CIT SMART ATTENDANCE - SMS CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env to configure real SMS sending with MSG91.
# NEVER commit the real .env file to Git! (.env is already in .gitignore)
#
# Default Provider Mode: 'mock' (Safe demo mode, zero external calls, zero cost)
# Live Provider Mode:    'msg91' (Real SMS delivery via MSG91 Flow API v5)
# ==============================================================================

# SMS Provider Selection ('mock' or 'msg91')
# Keep as 'mock' for testing; switch to 'msg91' when ready to dispatch real SMS.
SMS_PROVIDER=mock

# MSG91 Authentication Key (Found in MSG91 Dashboard -> Settings -> Authkey)
# REQUIRED when SMS_PROVIDER=msg91
SMS_API_KEY=your_msg91_authkey_here

# 6-Character Approved Sender ID / Header registered on Indian DLT (e.g. CITSYS)
SMS_SENDER_ID=CITSYS

# MSG91 Flow Template ID (Configured in MSG91 Campaign/Flow builder for your DLT template)
# REQUIRED when SMS_PROVIDER=msg91
# Template Content: "CIT Alert: Your ward ##student_name## was marked ABSENT for ##subject_name## on ##date##. CIT Attendance Dept."
SMS_TEMPLATE_ID=your_msg91_flow_template_id_here

# Optional: Indian Telecom DLT Template ID (numeric ID from Jio/Airtel/Vil DLT portal)
SMS_DLT_TE_ID=

# Optional: Principal Entity ID (PE ID / Registration ID from DLT portal)
SMS_ENTITY_ID=

# Backend Server Port (Default: 3001)
BACKEND_PORT=3001

# Firebase Configuration
FIREBASE_PROJECT_ID=clound-based-attendance
FIREBASE_WEB_API_KEY=
FIREBASE_CLI_CLIENT_ID=
FIREBASE_CLI_CLIENT_SECRET=
