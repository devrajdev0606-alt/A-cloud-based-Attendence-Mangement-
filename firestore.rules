rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // AUTHENTICATION & ROLE HELPER FUNCTIONS
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'admin@cit.edu') ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        request.auth.token.get('admin', false) == true
      );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // =========================================================================
    // REGISTRATION REQUESTS COLLECTION
    // =========================================================================
    // Newly registered applicants submit pending requests keyed by their Auth UID.
    // Admins review and approve/reject requests.
    // =========================================================================
    match /registrationRequests/{requestId} {
      allow create: if isSignedIn()
        && request.auth.uid == requestId
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role == 'student' || request.resource.data.role == 'faculty')
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name != ''
        && request.resource.data.email is string
        && request.resource.data.email != ''
        && !('password' in request.resource.data)
        && !('passwordHash' in request.resource.data)
        && !('admin' in request.resource.data);

      allow read: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == requestId ||
          resource.data.uid == request.auth.uid ||
          resource.data.email == request.auth.token.email
        )
      );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // STUDENTS COLLECTION (Biometric Data Protected)
    // =========================================================================
    // Contains student profiles including sensitive faceDescriptor biometrics.
    // Read: Restricted strictly to the student themselves (UID/Email) or Admin.
    // Update: Admin (all fields) or Student (own faceDescriptor/faceRegistered only).
    // Create/Delete: Admin only.
    // =========================================================================
    match /students/{studentId} {
      allow read: if isOwner(studentId) || (isSignedIn() && resource.data.email == request.auth.token.email) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isOwner(studentId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['faceDescriptor', 'faceRegistered'])
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // FACULTY COLLECTION
    // =========================================================================
    // Contains approved faculty profiles.
    // Read: Restricted strictly to the faculty member themselves (UID/Email) or Admin.
    // Create/Update/Delete: Admin only.
    // =========================================================================
    match /faculty/{facultyId} {
      allow read: if isOwner(facultyId) || (isSignedIn() && resource.data.email == request.auth.token.email) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // DEPARTMENTS COLLECTION
    // =========================================================================
    // Read: allowed for registration dropdowns and dashboards.
    // Write: strictly admin only.
    // =========================================================================
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // SUBJECTS COLLECTION
    // =========================================================================
    // Contains subject metadata, assigned facultyId, and enrolled studentIds.
    // Read:
    // - Admin: full access.
    // - Assigned Faculty: modern faculty UID or verified legacy email.
    // - Enrolled Student: authenticated UID is present in studentIds.
    // Write: strictly admin only.
    // =========================================================================
    match /subjects/{subjectId} {
      function isAssignedFaculty() {
        return ('facultyId' in resource.data && resource.data.facultyId == request.auth.uid) ||
          ('facultyUid' in resource.data && resource.data.facultyUid == request.auth.uid) ||
          (
            'facultyId' in resource.data &&
            resource.data.facultyId is string &&
            resource.data.facultyId != '' &&
            exists(/databases/$(database)/documents/faculty/$(resource.data.facultyId)) &&
            'email' in get(/databases/$(database)/documents/faculty/$(resource.data.facultyId)).data &&
            get(/databases/$(database)/documents/faculty/$(resource.data.facultyId)).data.email == request.auth.token.email
          );
      }

      function isEnrolledStudent() {
        return ('studentIds' in resource.data) && (
          request.auth.uid in resource.data.studentIds ||
          (
            exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
            'studentId' in get(/databases/$(database)/documents/students/$(request.auth.uid)).data &&
            get(/databases/$(database)/documents/students/$(request.auth.uid)).data.studentId in resource.data.studentIds
          )
        );
      }

      allow read: if isAdmin() || (
        isSignedIn() && (
          isAssignedFaculty() ||
          isEnrolledStudent()
        )
      );
      allow write: if isAdmin();
    }

    // =========================================================================
    // ATTENDANCE SESSIONS COLLECTION
    // =========================================================================
    // Active and conducted classroom beacons created by faculty.
    // Read:
    // - Admin: full access.
    // - Faculty: their own sessions or assigned subject sessions.
    // - Enrolled Student: sessions for subjects they are enrolled in.
    // Create: Verified faculty member assigned to the subject (Auth UID or verified legacy email).
    // Update: Owner faculty member (can toggle active status to stop attendance).
    // Delete: Admin only.
    // =========================================================================
    match /attendanceSessions/{sessionId} {
      function isAssignedFacultyForSession() {
        return isSignedIn() && (
          ('facultyUid' in resource.data && resource.data.facultyUid == request.auth.uid) ||
          ('facultyId' in resource.data && resource.data.facultyId == request.auth.uid) ||
          (
            'subjectId' in resource.data &&
            resource.data.subjectId is string &&
            resource.data.subjectId != '' &&
            exists(/databases/$(database)/documents/subjects/$(resource.data.subjectId)) &&
            (
              get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.facultyId == request.auth.uid ||
              (
                'facultyUid' in get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data &&
                get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.facultyUid == request.auth.uid
              ) ||
              (
                'facultyId' in get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data &&
                exists(/databases/$(database)/documents/faculty/$(get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.facultyId)) &&
                get(/databases/$(database)/documents/faculty/$(get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.facultyId)).data.email == request.auth.token.email
              )
            )
          )
        );
      }

      function isEnrolledStudentForSession() {
        return isSignedIn()
          && 'subjectId' in resource.data
          && resource.data.subjectId is string
          && resource.data.subjectId != ''
          && exists(/databases/$(database)/documents/subjects/$(resource.data.subjectId))
          && 'studentIds' in get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data
          && (
            request.auth.uid in get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.studentIds ||
            (
              exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
              'studentId' in get(/databases/$(database)/documents/students/$(request.auth.uid)).data &&
              get(/databases/$(database)/documents/students/$(request.auth.uid)).data.studentId in get(/databases/$(database)/documents/subjects/$(resource.data.subjectId)).data.studentIds
            )
          );
      }

      function isValidFacultySessionCreation() {
        return isSignedIn()
          && 'facultyUid' in request.resource.data
          && request.resource.data.facultyUid == request.auth.uid
          && 'subjectId' in request.resource.data
          && request.resource.data.subjectId is string
          && request.resource.data.subjectId != ''
          && 'active' in request.resource.data
          && request.resource.data.active == true
          && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
          && (
            get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.facultyId == request.auth.uid ||
            ('facultyId' in request.resource.data && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.facultyId == request.resource.data.facultyId) ||
            ('facultyUid' in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data && get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.facultyUid == request.auth.uid) ||
            (
              'facultyId' in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data &&
              exists(/databases/$(database)/documents/faculty/$(get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.facultyId)) &&
              get(/databases/$(database)/documents/faculty/$(get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.facultyId)).data.email == request.auth.token.email
            )
          );
      }

      allow read: if isAdmin() || (
        isSignedIn() && (
          isAssignedFacultyForSession() ||
          isEnrolledStudentForSession()
        )
      );
      allow create: if isAdmin() || isValidFacultySessionCreation();
      allow update: if isAdmin() || (
        isSignedIn() && (
          ('facultyUid' in resource.data && resource.data.facultyUid == request.auth.uid) ||
          ('facultyId' in resource.data && resource.data.facultyId == request.auth.uid)
        )
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // ATTENDANCE RECORDS COLLECTION
    // =========================================================================
    // Verified attendance submissions and faculty approved regularisation records.
    // Create: Enforces authentic student ownership (live session) OR verified instructor
    // approval for manual attendance correction.
    // Read: The submitting student, the course instructor, or Admin.
    // Update / Delete: Strictly admin only.
    // =========================================================================
    match /attendance/{recordId} {
      function isValidAttendanceSubmission() {
        return isSignedIn()
          && 'studentUid' in request.resource.data
          && request.resource.data.studentUid == request.auth.uid
          && 'sessionId' in request.resource.data
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId != ''
          && 'subjectId' in request.resource.data
          && request.resource.data.subjectId is string
          && request.resource.data.subjectId != ''
          && 'date' in request.resource.data
          && request.resource.data.date is string
          && exists(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId))
          && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
          && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.active == true
          && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.subjectId == request.resource.data.subjectId
          && 'studentIds' in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data
          && (
            request.auth.uid in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.studentIds ||
            (
              'studentId' in request.resource.data &&
              request.resource.data.studentId in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.studentIds &&
              (
                (
                  request.resource.data.studentId is string &&
                  request.resource.data.studentId != '' &&
                  exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
                  'email' in get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data &&
                  get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.email == request.auth.token.email
                ) ||
                request.resource.data.studentId == request.auth.uid
              )
            )
          );
      }

      function isValidFacultyCorrectionAttendance() {
        return isSignedIn()
          && 'sessionId' in request.resource.data
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId != ''
          && 'subjectId' in request.resource.data
          && request.resource.data.subjectId is string
          && request.resource.data.subjectId != ''
          && 'date' in request.resource.data
          && request.resource.data.date is string
          && (
            ('attendanceMethod' in request.resource.data && request.resource.data.attendanceMethod == 'correction') ||
            ('source' in request.resource.data && request.resource.data.source == 'faculty_correction')
          )
          && exists(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId))
          && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
          && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.subjectId == request.resource.data.subjectId
          && (
            // Assigned faculty for this session
            ('facultyUid' in get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.facultyUid == request.auth.uid) ||
            ('facultyId' in get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.facultyId == request.auth.uid) ||
            (
              'facultyId' in get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data &&
              exists(/databases/$(database)/documents/faculty/$(get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.facultyId)) &&
              get(/databases/$(database)/documents/faculty/$(get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.facultyId)).data.email == request.auth.token.email
            )
          )
          && 'studentIds' in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data
          && (
            ('studentUid' in request.resource.data && request.resource.data.studentUid in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.studentIds) ||
            ('studentId' in request.resource.data && request.resource.data.studentId in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.studentIds)
          );
      }

      allow create: if isAdmin() || (isSignedIn() && (isValidAttendanceSubmission() || isValidFacultyCorrectionAttendance()));
      allow read: if isAdmin() || (
        isSignedIn() && (
          ('studentUid' in resource.data && resource.data.studentUid == request.auth.uid) ||
          ('studentId' in resource.data && resource.data.studentId == request.auth.uid) ||
          ('facultyUid' in resource.data && resource.data.facultyUid == request.auth.uid) ||
          ('facultyId' in resource.data && resource.data.facultyId == request.auth.uid)
        )
      );
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // ATTENDANCE CORRECTION REQUESTS COLLECTION
    // =========================================================================
    // Students submit attendance correction requests for missed/unrecorded sessions.
    // Faculty review (approve/reject) only requests assigned to sessions they conducted.
    // Admins retain full audit and management access.
    // =========================================================================
    match /attendanceCorrectionRequests/{requestId} {
      function isValidCorrectionCreate() {
        return isSignedIn()
          && 'studentUid' in request.resource.data
          && request.resource.data.studentUid == request.auth.uid
          && 'status' in request.resource.data
          && request.resource.data.status == 'pending'
          && 'reason' in request.resource.data
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 500
          && 'sessionId' in request.resource.data
          && request.resource.data.sessionId is string
          && request.resource.data.sessionId != ''
          && 'subjectId' in request.resource.data
          && request.resource.data.subjectId is string
          && request.resource.data.subjectId != ''
          && 'date' in request.resource.data
          && request.resource.data.date is string
          && exists(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId))
          && exists(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId))
          && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.subjectId == request.resource.data.subjectId
          && (
            // Session faculty matches submitted faculty
            ('facultyUid' in get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data && 'facultyUid' in request.resource.data && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.facultyUid == request.resource.data.facultyUid) ||
            ('facultyId' in get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data && 'facultyId' in request.resource.data && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.facultyId == request.resource.data.facultyId) ||
            ('facultyId' in get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data && 'facultyUid' in request.resource.data && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.facultyId == request.resource.data.facultyUid) ||
            ('facultyUid' in get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data && 'facultyId' in request.resource.data && get(/databases/$(database)/documents/attendanceSessions/$(request.resource.data.sessionId)).data.facultyUid == request.resource.data.facultyId)
          )
          && 'studentIds' in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data
          && (
            // Authenticated student is enrolled in subject
            request.auth.uid in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.studentIds ||
            (
              'studentId' in request.resource.data &&
              request.resource.data.studentId in get(/databases/$(database)/documents/subjects/$(request.resource.data.subjectId)).data.studentIds &&
              (
                (
                  request.resource.data.studentId is string &&
                  request.resource.data.studentId != '' &&
                  exists(/databases/$(database)/documents/students/$(request.resource.data.studentId)) &&
                  'email' in get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data &&
                  get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.email == request.auth.token.email
                ) ||
                request.resource.data.studentId == request.auth.uid
              )
            )
          )
          && (!('reviewedAt' in request.resource.data) || request.resource.data.reviewedAt == null)
          && (!('reviewedBy' in request.resource.data) || request.resource.data.reviewedBy == null)
          && (!('reviewReason' in request.resource.data) || request.resource.data.reviewReason == null);
      }

      function isAssignedFacultyForRequest() {
        return (
          ('facultyUid' in resource.data && resource.data.facultyUid == request.auth.uid) ||
          ('facultyId' in resource.data && resource.data.facultyId == request.auth.uid) ||
          (
            'facultyId' in resource.data &&
            resource.data.facultyId is string &&
            resource.data.facultyId != '' &&
            exists(/databases/$(database)/documents/faculty/$(resource.data.facultyId)) &&
            'email' in get(/databases/$(database)/documents/faculty/$(resource.data.facultyId)).data &&
            get(/databases/$(database)/documents/faculty/$(resource.data.facultyId)).data.email == request.auth.token.email
          )
        );
      }

      function isValidFacultyReview() {
        return isSignedIn()
          && isAssignedFacultyForRequest()
          && 'status' in resource.data
          && resource.data.status == 'pending'
          && 'status' in request.resource.data
          && (request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
          && 'reviewedBy' in request.resource.data
          && request.resource.data.reviewedBy == request.auth.uid
          && request.resource.data.studentUid == resource.data.studentUid
          && request.resource.data.sessionId == resource.data.sessionId
          && request.resource.data.subjectId == resource.data.subjectId
          && request.resource.data.reason == resource.data.reason
          && request.resource.data.createdAt == resource.data.createdAt
          && (!('studentId' in resource.data) || request.resource.data.studentId == resource.data.studentId)
          && (!('facultyUid' in resource.data) || request.resource.data.facultyUid == resource.data.facultyUid)
          && (!('facultyId' in resource.data) || request.resource.data.facultyId == resource.data.facultyId);
      }

      allow read: if isAdmin() || (
        isSignedIn() && (
          ('studentUid' in resource.data && resource.data.studentUid == request.auth.uid) ||
          ('studentId' in resource.data && resource.data.studentId == request.auth.uid) ||
          isAssignedFacultyForRequest()
        )
      );
      allow create: if isAdmin() || isValidCorrectionCreate();
      allow update: if isAdmin() || isValidFacultyReview();
      allow delete: if isAdmin();
    }

    // Legacy alias collection match (if present in historical test data)
    match /attendanceRecords/{recordId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // SYSTEM SETTINGS COLLECTION
    // =========================================================================
    // Geofencing thresholds and configuration settings.
    // Read: authenticated users.
    // Write: strictly admin only.
    // =========================================================================
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

